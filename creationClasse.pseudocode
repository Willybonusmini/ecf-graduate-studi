Classe Humain
    Attributs : 
        nom: chaine
        prenom: chaine
        dateDeNaissance: date
        taillecm: entier
        poids: réel
        mail: chaine

    Methodes : 
        fonction getIMC() réel faire
            //poids / tailles en m au carré
            tailleM: réel
            tailleM = taillecm / 100

            imc: réel
            imc = poids / (tailleM * tailleM)
            retourne imc
        fin fonction

        fonction remplirobjet(anom, aprenom, adateDeNaissance, ataillecm, apoids, amail) faire
        nom = anom
        prenom = aprenom
        dateDeNaissance = adateDeNaissance
        taillecm = ataillecm
        poids = apoids
        mail = amail
fin classe

debut
    humain1: Humain
    humain1 = nouveau humain

    humain1.remplirObjet("Claire", "Martin", "31/12/1972", 160, 55, "claire.Martin@mail.com")
    

    écrireEcran("IMC de "+humain1.Nom+" "+humain1.prenom" : "+humain.getIMC());
    // IMC de Claire Martin : xx
fin

